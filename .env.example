# Configurarea serverului DAX. install.sh creează automat fișierul .env din acest model.

# Domeniul aplicației (trebuie să aibă o înregistrare DNS de tip A către IP-ul acestui server).
DOMAIN=dax.datix.ro
# E-mail pentru certificatul HTTPS (Let's Encrypt).
ACME_EMAIL=contact@datix.ro
# Adresa publică a aplicației (folosită pentru Face ID, linkuri și webhook-uri).
APP_URL=https://dax.datix.ro

# Cheia principală cu care se criptează cheile API salvate. Generată automat de install.sh.
# NU o pierde și NU o schimba: fără ea, cheile salvate în aplicație nu mai pot fi citite.
APP_SECRET_KEY=

# Codul pentru prima configurare a contului (generat automat; nu mai e folosit după configurare).
SETUP_TOKEN=

LOG_LEVEL=info
TZ=Europe/Bucharest

# Opțional: cheile se pot pune și aici în loc de Setări (cele din aplicație au prioritate).
# DEEPSEEK_API_KEY=
# WHMCS_API_IDENTIFIER=
# WHMCS_API_SECRET=
# DIRECTADMIN_LOGIN_KEY=
# CLOUDFLARE_API_TOKEN=
